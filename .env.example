# Cloudinary credentials for the Memories section (see README).
# Copy to .env.local for local dev; set the same values in Vercel > Settings > Environment Variables.
# Without these, Memories shows sample photos in dev and is hidden in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the tag that marks an upload as a memory (default "memories").
# CLOUDINARY_MEMORIES_TAG=memories

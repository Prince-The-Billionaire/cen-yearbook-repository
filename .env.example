# Cloudinary credentials for the Memories section (see README).
# Copy to .env.local for local dev; set the same values in Vercel > Settings > Environment Variables.
# Without these, Memories shows sample photos in dev and is hidden in production.
# Albums and their Cloudinary folders are defined in data/albums.ts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Privacy: phone numbers are hidden until a visitor enters this class code.
# Pick something 6+ characters and share it with the class only. If it is not set,
# phone numbers stay hidden for everyone. Changing it signs everyone out.
CLASS_CODE=
# Optional: extra secret mixed into the access cookie.
# CLASS_COOKIE_SECRET=
# Optional: contact shown on /privacy for correction or removal requests.
# PRIVACY_CONTACT=
